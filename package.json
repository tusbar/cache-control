{
  "name": "@tusbar/cache-control",
  "public": true,
  "license": "MIT",
  "version": "3.0.0",
  "author": "Bertrand Marron <bertrand.marron@gmail.com>",
  "description": "Format and parse HTTP Cache-Control header",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tusbar/cache-control.git"
  },
  "keywords": [
    "cache-control",
    "http",
    "rfc9111",
    "rfc8246",
    "rfc5861",
    "rfc7234"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "source": "./src/index.ts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "test": "jest",
    "check:ts": "tsc --noEmit",
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "devDependencies": {
    "@bizon/semantic-release-config": "^3.1.0",
    "@jest/globals": "^30.4.1",
    "@jest/types": "^30.4.1",
    "@swc/core": "^1.15.40",
    "@swc/jest": "^0.2.39",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.10.13",
    "eslint-config-xo-bizon": "^4.2.0",
    "jest": "^30.4.2",
    "jest-junit": "^17.0.0",
    "semantic-release": "^25.0.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "xo": "^1.2.3"
  },
  "release": {
    "extends": "@bizon/semantic-release-config"
  },
  "tsup": {
    "entry": [
      "src/index.ts"
    ],
    "format": [
      "cjs",
      "esm"
    ],
    "sourcemap": true,
    "dts": true
  },
  "packageManager": "pnpm@11.4.0+sha512.f0febc7e37552ab485494a914241b338e0b3580b93d54ce31f00933015880863129038a1b4ae4e414a0ee63ac35bf21197e990172c4a68256450b5636310968f"
}
